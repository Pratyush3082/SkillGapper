# =============================================================================
# SkillGapper Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.
# =============================================================================

# --- Flask / Backend ---
# Set to "development" for local development, "production" for deployment.
APP_ENV=development

# Secret key for Flask sessions and security.
# Generate a strong random value: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Database URL (SQLite by default).
# Point this to your own SQLite database file.
DATABASE_URL=sqlite:///instance/skillgapper.db

# Set to "1" to initialize/rebuild the database schema.
SKILLGAPPER_DB_INITIALIZE=1

# --- Ollama / AI Mentor ---
# Ollama chat endpoint (default local Ollama installation).
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_SHOW_URL=http://localhost:11434/api/show

# Name of the installed Ollama model to use for AI Mentor.
# Example: llama3.2:3b, qwen3:4b-instruct, etc.
# Run "ollama list" to see installed models.
OLLAMA_MODEL=llama3.2:3b

# Ollama request timeout in seconds (5-120).
OLLAMA_TIMEOUT_SECONDS=45

# Comma-separated list of vision-capable model names (leave empty to disable vision).
OLLAMA_VISION_MODELS=

# Set to "1" to enable vision capability detection via Ollama /api/show.
OLLAMA_VISION=

# --- Placement Prediction ---
# Set to "1" only after integration tests pass for the trained model.
# MODEL_VERIFIED is controlled in backend/placement_predictor.py.

# =============================================================================
