.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# --- Python distributions ---
*.egg-info/
dist/
build/
*.egg
*.whl

# --- Virtual environments and local env files ---
.env
.env.local
.env.*.local
.env.production
.env.development
secrets.env

# --- Flask/Backend ---
instance/
.webassets-cache
backend/database.db
*.sqlite
*.sqlite3
*.db

# --- Node.js / Frontend ---
node_modules/
