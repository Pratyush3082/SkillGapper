ml_model/jobpredictor/dataset/*.csv
ml_model/jobpredictor/experimental_output/
ml_model/jobpredictor/experimental_requirements.txt

# --- Project-specific local data (user databases, recovery artifacts) ---
database-rebuild-20261023/
database-recovery-20261023/

